# ============================================================
# .gitignore — Site MyGamingTips
# ============================================================

# === Dossiers de travail / sources non web ===
# Sources d'images originales (noms français, versions non utilisées)
imageapp/

# Dossier de travail de l'agent ZCode (mockups, sessions brainstorm)
.superpowers/

# === OS / éditeur ===
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# === Logs ===
*.log
npm-debug.log*

# === Dépendances (au cas où on ajoute un build plus tard) ===
node_modules/

# === Build outputs ===
dist/
build/

# === Fichiers sensibles / env ===
.env
.env.local
.env.*.local
*.pem
*.key

# === Cache ===
.cache/
.parcel-cache/
.netlify/
.vercel/

# === Originaux images (2026-09-12) ===
# Les sources lourdes restent sur disque pour régénérer les WebP
# (compresser_images_web.py) mais ne sont plus versionnées : le site
# ne sert que les .webp. Ne pas committer de jpg/png sous screenshots.
assets/screenshots/**/*.jpg
assets/screenshots/**/*.jpeg
assets/screenshots/**/*.png
assets/promo-hero.png
